{
  "manifest_version": 3,
  "name": "MC 下载面板分析",
  "version": "1.1.0",
  "description": "在 CurseForge 作者后台展示各项目总下载量、每日增长与更新优先级、MC 版本适配分析。",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://authors.curseforge.com/*",
    "https://api.cfwidget.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MC 下载面板分析",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://authors.curseforge.com/*"],
      "js": ["lib/stats.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
